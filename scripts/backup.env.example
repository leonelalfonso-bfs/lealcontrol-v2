# Copiar a /etc/lealcontrol/backup.env en el VPS (chmod 600).
# No commitear con contraseñas reales.

LEAL_STAGING_DIR=/opt/lealcontrol-staging
LEAL_PROD_DIR=/opt/lealcontrol-v2
LEAL_BACKUP_BASE_DIR=/var/backups/lealcontrol
LEAL_BACKUP_RETENTION_DAYS=14

# Opcional — solo si configuraste rclone (rclone config)
# LEAL_RCLONE_REMOTE=gdrive:LEAL_BACKUPS
