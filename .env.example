# Copiar a .env en el servidor. Nunca commitear .env.
#
# Pruebas (v2.lealcontrol.com): PUBLIC_WEB_ORIGIN=https://v2.lealcontrol.com  carpeta /opt/lealcontrol-staging
# Producción (erp.lealcontrol.com): PUBLIC_WEB_ORIGIN=https://erp.lealcontrol.com  carpeta /opt/lealcontrol-v2
# Usá usuario y base DISTINTOS en cada ambiente.

POSTGRES_DB=lealcontrol_v2
POSTGRES_USER=lealv2
POSTGRES_PASSWORD=

JWT_SECRET=
Jwt__Issuer=lealcontrol
Jwt__Audience=lealcontrol-web
Jwt__LifetimeHours=8

Cors__Origins__0=https://v2.lealcontrol.com

WHATSAPP_GATEWAY_URL=http://evolution-api-evolution-api-1:8080
WHATSAPP_GATEWAY_APIKEY=
WHATSAPP_GATEWAY_WEBHOOK_URL=https://v2.lealcontrol.com/api/communications/whatsapp/webhook
WHATSAPP_WEBHOOK_SECRET=

META_APP_SECRET=
# Activar solo cuando Comunicaciones esté listo para sincronizar cuentas de correo.
COMMUNICATIONS_BACKGROUND_SYNC_ENABLED=false
# Rutas interactivas de bandeja/canales; correo y webhooks existentes siguen disponibles.
COMMUNICATIONS_INBOX_ENABLED=false
Meta__VerifyToken=

SUPERADMIN_BOOTSTRAP_PASSWORD=
SUPERADMIN_BOOTSTRAP_EMAIL=admin@lealcontrol.com

PUBLIC_WEB_ORIGIN=https://v2.lealcontrol.com
